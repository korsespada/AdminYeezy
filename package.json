{
  "name": "yeezyunique-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run db:tunnel",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "predev:with-bot": "npm run db:tunnel",
    "dev:with-bot": "concurrently \"powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1\" \"node scripts/telegram-bot.js\"",
    "db:tunnel": "powershell -ExecutionPolicy Bypass -File scripts/db-tunnel.ps1",
    "build": "next build",
    "start": "next start",
    "db:migrate:scraping": "node scripts/migrate-scraping-schema.js && node scripts/migrate-batch-product-identity.js && node scripts/migrate-product-source-position.js && node scripts/migrate-task-history-jsonb.js && node scripts/migrate-batch-ai.js && node scripts/harden-batch-workflow.js && node scripts/migrate-shoe-taxonomy.js && node scripts/sanitize-supplier-ai-instructions.js && node scripts/merge-supplier-photo-instructions.js",
    "db:migrate:batch-ai": "node scripts/migrate-batch-ai.js",
    "db:migrate:media-seo": "node scripts/ensure-media-seo-schema.js",
    "db:migrate:supplier-catalog-ids": "node scripts/migrate-supplier-catalog-ids.js",
    "db:audit:batches": "node scripts/audit-batch-workflow.js",
    "db:backfill:batch-products": "node scripts/backfill-batch-products.js",
    "db:backfill:scraping-files": "node scripts/backfill-scraping-files.js",
    "db:repair:gender": "node scripts/repair-canonical-gender.js",
    "db:normalize-result-paths": "node scripts/normalize-result-paths.js",
    "ai:catalog-worker": "concurrently --kill-others-on-fail \"node scripts/ai-catalog-worker.js\" \"node scripts/batch-ai-worker.js\"",
    "ai:seo-worker": "node scripts/ai-catalog-worker.js",
    "ai:batch-worker": "node scripts/batch-ai-worker.js",
    "lint": "eslint .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "check": "npm run lint && npm test -- --run && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@elastic/elasticsearch": "^9.3.4",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "dotenv": "^17.3.1",
    "https-proxy-agent": "^9.0.0",
    "ioredis": "^5.10.0",
    "lucide-react": "^1.17.0",
    "next": "^16.2.9",
    "pg": "^8.20.0",
    "pocketbase": "^0.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.7.0",
    "redis": "^5.11.0",
    "sharp": "^0.34.5",
    "socks-proxy-agent": "^9.0.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.7",
    "fast-check": "^3.15.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "overrides": {
    "fast-xml-builder": "^1.2.0",
    "fast-xml-parser": "^5.8.0",
    "picomatch": "^4.0.4"
  },
  "description": "Операционная Next.js-админка YeezyUnique. Она сохраняется как отдельное приложение и разворачивается на:",
