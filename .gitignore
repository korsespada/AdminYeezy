# dependencies
**/node_modules/

# builds
**/dist/
**/build/
**/.next/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tmp/*.log

# env
**/.env
**/.env.*
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Allow .env.example files
!**/.env.example
!.env.example

# vercel
.vercel/

# OS
.DS_Store
Thumbs.db

# Vite/TS temp
**/*.timestamp-*.mjs
**/*.tsbuildinfo

# Local browser verification artifacts
.playwright-cli/
output/playwright/

# Python bytecode
**/__pycache__/
**/*.py[cod]
.venv/

# Локальная песочница: разовые скрипты и логи, в репозиторий не нужны
/tmp/

# Локальные заметки и разовые проверки в корне
/plan-chromoff-ai.txt
/test-api.js

# ВАЖНО: data/ НЕ игнорируется.
# Выгрузки поставщиков (например data/david-studio/catalog.json) читает
# админка на проде, поэтому файлы должны попадать в репозиторий и в образ.
# Обновляются командой: npm run catalog:sync:david-studio
