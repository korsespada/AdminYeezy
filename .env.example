# Public/admin URLs
ADMIN_BASE_URL=https://admin.example.com
RAILS_API_URL=https://api.example.com/api/v1
RAILS_ADMIN_EMAIL=admin@example.com
RAILS_ADMIN_PASSWORD=replace_me
# Optional temporary override with an already issued Rails admin JWT.
RAILS_ADMIN_TOKEN=
RAILS_IMPORT_CHUNK_SIZE=200
VITE_API_URL=https://admin.example.com

# Transitional legacy catalog access.
# Prefer explicit database variables below. DATABASE_URL is a compatibility fallback
# for old local scripts only; never point it at Rails CRM Postgres.
DATABASE_URL=
ANALYTICS_DATABASE_URL=
LEGACY_CATALOG_DATABASE_URL=postgresql://legacy_readonly_user:replace_me@postgres.internal:5432/shop

# Technical AdminYeezy database: suppliers, scraping tasks, CSV artifacts, AI batches.
SCRAPING_DATABASE_URL=postgresql://scraping_user:replace_me@postgres.internal:5432/yeezy_scraping

# Optional Redis and Elasticsearch used by transitional catalog code.
REDIS_HOST=redis.internal
REDIS_PORT=6379
REDIS_PASSWORD=
ES_HOST=http://elasticsearch.internal:9200
ES_USERNAME=
ES_PASSWORD=

# Optional scraper worker.
SCRAPER_WORKER_URL=http://scraper-worker.internal:3000
SCRAPER_WORKER_SECRET=replace_me
PYTHON_PATH=python

# Telegram notifications and bot.
BOT_TOKEN=replace_me
BOT_PROXY=
MANAGER_CHAT_ID=replace_me
DEFAULT_SZWEGO_COOKIE=

# S3-compatible media storage.
S3_ENDPOINT=https://s3.example.com
S3_REGION=replace_me
S3_ACCESS_KEY=replace_me
S3_SECRET_KEY=replace_me
S3_BUCKET=replace_me
S3_PUBLIC_DOMAIN=https://static.example.com

# Local Cockpit Tools worker for the published AI catalog.
# Use the full OpenAI-compatible chat completions endpoint shown in Cockpit Tools.
COCKPIT_API_URL=http://localhost:50943/v1/chat/completions
COCKPIT_API_KEY=replace_me
COCKPIT_MODEL=gpt-5.6-luna
# Must match AI_CATALOG_WORKER_TOKEN on the Rails API server.
AI_CATALOG_WORKER_TOKEN=replace_with_a_long_random_value
AI_CATALOG_WORKER_POLL_MS=5000
AI_CATALOG_WORKER_MAX_IMAGES=9
AI_CATALOG_MEDIA_HOSTS=static.yeezyunique.ru,xcimg.szwego.com

# Legacy/other optional AI processing.
OPENROUTER_API_KEY=replace_me
# Supports http://, https://, socks5:// and socks5h:// proxy URLs.
OPENROUTER_PROXY_URL=socks5h://user:password@proxy-host:1080

# Manual cleanup script: scripts/delete_products_by_csv.py
DELETE_PRODUCTS_CSV_PATH=C:\path\to\products.csv
DELETE_PRODUCTS_CSV_COLUMN=productId
DELETE_PRODUCTS_DB_COLUMN=external_id

# Development-only fallback login. Do not configure in production.
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
